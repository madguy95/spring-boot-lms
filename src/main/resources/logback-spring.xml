<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Property for log pattern with correlation ID -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC} [%thread] %-5level %logger{36} [ReqId:%X{correlationId:-NO_ID}] [User:%X{userId:-system}] [%X{requestMethod} %X{requestUri}] - %msg%n"/>

    <!-- ========================================
         Console Appender — always active.
         On Render/Docker, stdout is captured by the platform; file logs are pointless
         (ephemeral filesystem, no shell to read them).
         ======================================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============================================================================
         DEV PROFILE — local laptop. Writes rolling logs under ./logs/.
         File appenders are wrapped in <springProfile> so they're never *instantiated*
         on non-dev runs — otherwise RollingFileAppender would try to mkdir at startup
         and crash inside containers where the working dir isn't writable.
         ============================================================================ -->
    <springProfile name="dev">

        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/spring-jwt.log</file>
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>logs/archived/spring-jwt.%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>30</maxHistory>
                <totalSizeCap>10GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="FILE"/>
            <queueSize>512</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <includeCallerData>false</includeCallerData>
        </appender>

        <appender name="QUARTZ_DETAIL" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/quartz/quartz-detail.log</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>logs/quartz/archived/quartz-detail.%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>30</maxHistory>
                <totalSizeCap>5GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <appender name="KAFKA_DETAIL" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/kafka/kafka-detail.log</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>logs/kafka/archived/kafka-detail.%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>30</maxHistory>
                <totalSizeCap>5GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC"/>
        </root>

        <logger name="com.springjwt" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC"/>
        </logger>

        <!-- Quartz routing — additivity=true so messages also hit CONSOLE + ASYNC via root. -->
        <logger name="com.springjwt.module.scheduler" level="INFO" additivity="true">
            <appender-ref ref="QUARTZ_DETAIL"/>
        </logger>
        <logger name="com.springjwt.core.quartz" level="INFO" additivity="true">
            <appender-ref ref="QUARTZ_DETAIL"/>
        </logger>
        <logger name="org.quartz" level="INFO" additivity="true">
            <appender-ref ref="QUARTZ_DETAIL"/>
        </logger>
        <logger name="org.quartz.core" level="DEBUG" additivity="true">
            <appender-ref ref="QUARTZ_DETAIL"/>
        </logger>

        <!-- Kafka routing -->
        <logger name="com.springjwt.core.kafka" level="INFO" additivity="true">
            <appender-ref ref="KAFKA_DETAIL"/>
        </logger>
        <logger name="com.springjwt.module.message.business.producer" level="INFO" additivity="true">
            <appender-ref ref="KAFKA_DETAIL"/>
        </logger>
        <logger name="com.springjwt.module.message.business.consumer" level="INFO" additivity="true">
            <appender-ref ref="KAFKA_DETAIL"/>
        </logger>
        <logger name="com.springjwt.module.message" level="INFO" additivity="true">
            <appender-ref ref="KAFKA_DETAIL"/>
        </logger>
        <logger name="org.springframework.kafka" level="INFO" additivity="true">
            <appender-ref ref="KAFKA_DETAIL"/>
        </logger>
        <logger name="org.apache.kafka" level="INFO" additivity="true">
            <appender-ref ref="KAFKA_DETAIL"/>
        </logger>
        <logger name="org.apache.kafka.clients.consumer" level="DEBUG" additivity="true">
            <appender-ref ref="KAFKA_DETAIL"/>
        </logger>
        <logger name="org.apache.kafka.clients.producer" level="DEBUG" additivity="true">
            <appender-ref ref="KAFKA_DETAIL"/>
        </logger>

    </springProfile>

    <!-- ============================================================================
         STAGING / PROD / ANY-NON-DEV — console only. Render's UI aggregates stdout.
         No mkdir, no rolling files, no permission errors on read-only filesystems.
         ============================================================================ -->
    <springProfile name="!dev">

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <logger name="com.springjwt" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>

    </springProfile>

    <!-- ========================================
         Level-only loggers — no appender-ref, so they work in every profile by
         inheriting CONSOLE (and ASYNC where applicable) from root.
         ======================================== -->
    <logger name="com.springjwt.core.logging" level="DEBUG"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.hibernate.SQL" level="DEBUG"/>
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE"/>

</configuration>
