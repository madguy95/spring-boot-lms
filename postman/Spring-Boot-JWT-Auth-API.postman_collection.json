    {
      "name": "4. Scheduler (Quartz)",
      "item": [
        {
          "name": "Create Job (Auto-Generate)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Auto-generate unique job name",
                  "const timestamp = Date.now();",
                  "const randomNum = Math.floor(Math.random() * 10000);",
                  "const uniqueId = timestamp + '_' + randomNum;",
                  "",
                  "const jobName = 'Job_' + uniqueId;",
                  "const description = 'Auto-generated test job at ' + new Date().toISOString();",
                  "",
                  "pm.collectionVariables.set('generated_job_name', jobName);",
                  "pm.collectionVariables.set('generated_job_description', description);",
                  "",
                  "console.log('🆕 Generated new job:');",
                  "console.log('   Job Name: ' + jobName);",
                  "console.log('   Description: ' + description);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.id) {",
                  "        pm.collectionVariables.set(\"jobId\", jsonData.data.id);",
                  "        console.log(\"✅ Job created successfully!\");",
                  "        console.log(\"   ID: \" + jsonData.data.id);",
                  "        console.log(\"   Name: \" + pm.collectionVariables.get('generated_job_name'));",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jobName\": \"{{generated_job_name}}\",\n    \"jobGroup\": \"TEST\",\n    \"jobClass\": \"com.springjwt.module.scheduler.jobs.HealthCheckJob\",\n    \"description\": \"{{generated_job_description}}\",\n    \"cronExpression\": \"0 0/10 * * * ?\",\n    \"parameters\": {\n        \"timeout\": \"30\",\n        \"retries\": \"3\"\n    }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/scheduler/jobs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "scheduler",
                "jobs"
              ]
            },
            "description": "✅ AUTO-GENERATE JOB NAME!\n\n🎯 Mỗi lần chạy sẽ tự động tạo:\n- Job Name: Job_<timestamp>_<random>\n- Description: Auto-generated test job at <ISO timestamp>\n\n📝 Ví dụ:\n- Job_1730012345678_4521\n- Auto-generated test job at 2025-10-27T10:30:45.678Z\n\n✅ Có thể chạy nhiều lần mà không bị lỗi duplicate job name!"
          },
          "response": []
        },
