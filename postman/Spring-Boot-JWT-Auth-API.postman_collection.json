    {
      "name": "6. Audit Logs (Admin Only)",
      "item": [
        {
          "name": "Get User Audit Logs",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/audit-logs/user/admin?page=0&size=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "audit-logs",
                "user",
                "admin"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0",
                  "description": "Page number (0-based)"
                },
                {
                  "key": "size",
                  "value": "20",
                  "description": "Page size"
                }
              ]
            },
            "description": "📋 Retrieve paginated audit logs for a specific user.\n\n🔐 Admin role required\n\n📝 Parameters:\n- username: Target username (in path)\n- page: Page number (default: 0)\n- size: Page size (default: 20)\n\n✅ Returns logs sorted by timestamp (newest first)"
          },
          "response": []
        },
        {
          "name": "Get Audit Logs by Date Range",
          "request": {
            "auth": {
              "type": "bearer",
